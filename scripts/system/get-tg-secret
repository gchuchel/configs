#!/run/current-system/sw/bin/bash
# Извлекает Secret и готовую ссылку из логов tg-ws-proxy
# Сохраняет в ~/.config/tg-proxy.conf:
#   строка 1: secret
#   строка 2: host:port
#   строка 3: tg:// ссылка

CONFIG_DIR="$HOME/.config"
CONFIG_FILE="$CONFIG_DIR/tg-proxy.conf"
LOG_FILE="/tmp/tg-proxy-update.log"
MAX_LOG_LINES=100

mkdir -p "$CONFIG_DIR"

# Получаем данные из логов
SECRET=$(journalctl --user -u tg-ws-proxy -o cat | grep -oP 'Secret:\s+\K[0-9a-f]+' | tail -1)
LINK=$(journalctl --user -u tg-ws-proxy -o cat | grep -oP 'dd \(random padding\):\s+\Ktg://[^\s]+' | tail -1)

if [ -n "$SECRET" ] && [ -n "$LINK" ]; then
    PORT=$(echo "$LINK" | grep -oP 'port=\K[0-9]+')
    
    cat > "$CONFIG_FILE" << EOF
$SECRET
127.0.0.1:$PORT
$LINK
EOF
    
    # Запись в лог с ограничением
    echo "Config updated at $(date)" >> "$LOG_FILE"
    # Оставляем только последние MAX_LOG_LINES строк
    tail -n $MAX_LOG_LINES "$LOG_FILE" > "$LOG_FILE.tmp"
    mv "$LOG_FILE.tmp" "$LOG_FILE"
else
    echo "No data yet at $(date)" >> "$LOG_FILE"
    tail -n $MAX_LOG_LINES "$LOG_FILE" > "$LOG_FILE.tmp"
    mv "$LOG_FILE.tmp" "$LOG_FILE"
fi
